// Cuối tuần 1 chỉ cần lưu lại từng lượt ghi âm.
// Các bảng Scenario / Card / CardState sẽ thêm ở cuối tuần 3 và 4,
// theo đúng mô hình dữ liệu trong docs/PLAN-LOCAL.md mục 8.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Recording {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())

  audioKey   String // khóa trong module storage, không phải đường dẫn tuyệt đối
  durationMs Int?

  text       String? // bản chép lời
  sttModel   String? // model nào tạo ra text này — cần khi đổi model về sau
  latencyMs  Int? // đo từ lúc nhận request tới lúc có text

  @@index([createdAt])
}

model Assessment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  audioKey   String
  targetText String

  sentenceGop Float
  worstGop    Float
  phoneCount  Int
  words       String // JSON: [{text, gop, phones:[{phone, gop, heardAs, ...}]}]

  // Bản ghi dùng để hiệu chỉnh ngưỡng, không phải bài luyện.
  isCalibration Boolean @default(false)

  // Bắt buộc, không phải tuỳ chọn: khi đổi model chấm, điểm cũ mất ý nghĩa
  // so sánh nếu không biết nó sinh ra từ đâu. Xem docs/SPEC.md mục 8.
  modelVersion String?
  latencyMs    Int?

  @@index([createdAt])
  @@index([isCalibration])
}
