# apps/web/.env đã có sẵn trong repo với giá trị mặc định chạy được ngay.
# File này chỉ liệt kê những gì có thể ghi đè trong apps/web/.env.local

# DATABASE_URL="file:../../../data/app.db"   # tính từ apps/web/prisma/
# SPEECH_URL="http://127.0.0.1:8000"         # speech-service trong Docker
# OLLAMA_URL="http://127.0.0.1:11434"        # Ollama native Windows (cuối tuần 3)
# DATA_DIR="../../data"                      # tính từ apps/web/
# TTS_VOICE="af_heart"
# TTS_SPEED="0.85"
